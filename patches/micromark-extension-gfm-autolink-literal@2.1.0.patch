+/**
+ * CJK prose punctuation terminates literal URLs, including a preceding emphasis
+ * trail (`**https://example.com/path**（note）`). Unicode letters remain valid in
+ * paths; explicit Markdown destinations and percent-encoded punctuation bypass
+ * this literal-autolink boundary.
+ *
+ * @param {Code} code
+ * @returns {boolean}
+ */
+function cjkPunctuation(code) {
+  return code !== null && code >= 0x3000 && /[、。〈〉《》「」『』【】〔〕！（），：；？［］｛｝]/u.test(String.fromCodePoint(code))
+}
