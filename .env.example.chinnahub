# ===========================================================================
#  Chinna Hub — Full Configuration Reference
#  Copy this to .env and fill in your values.
#
#  HOW TO GENERATE SECRETS:
#    AUTH_SECRET / KEY_VAULTS_SECRET:
#      openssl rand -base64 32
#
#  QUICK START ORDER:
#    1. Set APP_URL
#    2. Generate AUTH_SECRET and KEY_VAULTS_SECRET
#    3. Set DATABASE_URL (PostgreSQL)
#    4. Set REDIS_URL
#    5. Set S3 storage
#    6. Set Google OAuth (for social login)
#    7. Set SMTP (for email/password auth + verification)
#    8. Set at least one AI provider (e.g. OPENAI_API_KEY)
#    9. Run: pnpm run db:migrate
#   10. Run: pnpm run dev  (or  bun run dev)
# ===========================================================================

# ===========================================================================
# 1. APPLICATION
# ===========================================================================

# Your public-facing URL (no trailing slash)
# Local dev: http://localhost:3010
# Production: https://chinnahub.yourdomain.com
APP_URL=http://localhost:3010

# Same as APP_URL — used by Next.js for canonical URLs and auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Enable server-side database + auth features
NEXT_PUBLIC_SERVICE_MODE=server

# Enable authentication (required for multi-user)
NEXT_PUBLIC_ENABLE_AUTH=1

# App branding name shown in the UI
NEXT_PUBLIC_BRANDING_NAME="ChinnaHub"
NEXT_PUBLIC_ORG_NAME="Project-M"

# Uncomment to set a sub-path (e.g. /app) — only if deploying to a sub-path
# NEXT_PUBLIC_BASE_PATH=

# ===========================================================================
# 2. SECURITY SECRETS
# ===========================================================================
# Generate with: openssl rand -base64 32

# Authentication session secret (REQUIRED)
AUTH_SECRET="aDcsNP2WHQzN/38rrh2ps+NIfj0LsA/HBp/A27Ituh4="

# Database encryption key for API keys stored in DB (REQUIRED)
KEY_VAULTS_SECRET="aDcsNP2WHQzN/38rrh2ps+NIfj0LsA/HBp/A27Ituh4="

# Needed for Better-Auth
BETTER_AUTH_URL=http://localhost:3010
BETTER_AUTH_SECRET="aDcsNP2WHQzN/38rrh2ps+NIfj0LsA/HBp/A27Ituh4="
AUTH_TRUST_HOST=true

# ===========================================================================
# 3. DATABASE (PostgreSQL — required for server mode)
# ===========================================================================
#
# Options:
#   A) Neon (cloud, free tier):     https://neon.tech
#      DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
#   B) Supabase (cloud, free tier): https://supabase.com
#      DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
#   C) Local Docker:
#      docker run -d -e POSTGRES_PASSWORD=chinnahub -e POSTGRES_DB=chinnahub -p 5432:5432 postgres:16
#      DATABASE_URL=postgresql://postgres:chinnahub@localhost:5432/chinnahub
#
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/chinnahub
DATABASE_DRIVER=node

# If using Neon or Vercel Postgres, also set unpooled URL for migrations:
# DATABASE_URL_UNPOOLED=postgresql://postgres:your_password@host:5432/chinnahub?sslmode=require

# After setting DATABASE_URL, run database migrations:
#   pnpm run db:migrate
#   (or)  cd packages/database && bunx drizzle-kit migrate

# ===========================================================================
# 4. REDIS (required for background jobs, sessions, rate limiting)
# ===========================================================================
#
# Options:
#   A) Upstash (cloud, free tier): https://upstash.com → Create Redis DB → copy URL
#      REDIS_URL=redis://default:your_token@your-db.upstash.io:6379
#
#   B) Local Docker:
#      docker run -d -p 6379:6379 redis:7
#      REDIS_URL=redis://localhost:6379
#
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=chinnahub
REDIS_TLS=0

# Optional Redis auth (if your Redis requires a password):
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_password

# ===========================================================================
# 5. S3 OBJECT STORAGE (for file uploads, images, audio, video)
# ===========================================================================
#
# Options (all S3-compatible):
#
#   A) Cloudflare R2 (recommended — generous free tier):
#      1. Go to https://dash.cloudflare.com → R2
#      2. Create bucket named "chinnahub"
#      3. Create API token → copy Access Key ID and Secret
#      4. Bucket endpoint: https://<account_id>.r2.cloudflarestorage.com
#      S3_ENABLE_PATH_STYLE=1
#      S3_SET_ACL=0
#
#   B) MinIO (local Docker, self-hosted):
#      docker run -d -p 9000:9000 -p 9001:9001 \
#        -e MINIO_ROOT_USER=admin -e MINIO_ROOT_PASSWORD=chinnahub123 \
#        quay.io/minio/minio server /data --console-address ":9001"
#      Then create bucket "chinnahub" at http://localhost:9001
#      S3_ENDPOINT=http://localhost:9000
#      S3_ENABLE_PATH_STYLE=1
#      S3_SET_ACL=0
#
#   C) AWS S3:
#      S3_ENDPOINT=https://s3.amazonaws.com
#      S3_REGION=us-east-1
#      S3_ENABLE_PATH_STYLE=0
#      S3_SET_ACL=1
#

S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=chinnahub
S3_ENDPOINT=http://localhost:9000
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0

# Public domain for file URLs (set to your bucket's public URL or CDN)
# For Cloudflare R2 with public access: https://pub-xxx.r2.dev
# For MinIO local: http://localhost:9000/chinnahub
NEXT_PUBLIC_S3_DOMAIN=http://localhost:9000/chinnahub

# Region (required for some providers)
# S3_REGION=auto

# Use base64 for LLM vision in dev (avoids presigned URL issues)
LLM_VISION_IMAGE_USE_BASE64=0

# ===========================================================================
# 6. AUTHENTICATION — Google OAuth
# ===========================================================================
#
# SETUP STEPS:
#   1. Go to: https://console.cloud.google.com/apis/credentials
#   2. Create project (or select existing)
#   3. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   4. Application type: "Web application"
#   5. Add Authorized JavaScript origins:
#      - http://localhost:3010              (dev)
#      - https://chinnahub.yourdomain.com  (prod)
#   6. Add Authorized redirect URIs:
#      - http://localhost:3010/api/auth/callback/google       (dev)
#      - https://chinnahub.yourdomain.com/api/auth/callback/google  (prod)
#   7. Copy Client ID and Client Secret below
#
AUTH_SSO_PROVIDERS=google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Legacy aliases (some auth paths use these):
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your_google_client_secret

# ===========================================================================
# 7. AUTHENTICATION — Email / Password
# ===========================================================================
#
# Enable or disable email/password sign-up (set to 1 to disable, SSO-only)
AUTH_DISABLE_EMAIL_PASSWORD=0

# Require email verification before login (recommended for production)
AUTH_EMAIL_VERIFICATION=1

# Allowed email domains (leave empty to allow all)
# AUTH_ALLOWED_EMAILS=yourdomain.com,admin@other.com

# ===========================================================================
# 8. SMTP (for email verification, password reset)
# ===========================================================================
#
# Option A — Gmail (use App Password, not account password):
#   1. Enable 2FA on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create App Password → copy the 16-char code
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   (app password, no spaces)
#
# Option B — Resend (developer-friendly, generous free tier):
#   1. Sign up at https://resend.com
#   2. Create API Key
#   3. Add and verify your sending domain
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key
#
# Option C — Brevo / SendGrid / Postmark — same pattern, check their SMTP docs
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=noreply@chinnahub.app

# ===========================================================================
# 9. AI PROVIDERS — At least one is required for chat to work
# ===========================================================================

# --- OpenAI (GPT-4o, GPT-4, o1, etc.) ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key
# OPENAI_PROXY_URL=https://api.openai.com/v1

# --- Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.) ---
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# --- Google Gemini ---
# Get key: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=AIzaSy-your_google_api_key

# --- Ollama (local AI models — completely free) ---
# Install: https://ollama.com/  then run: ollama pull llama3
# OLLAMA_PROXY_URL=http://127.0.0.1:11434

# --- Groq (blazing fast inference, free tier) ---
# Get key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key

# --- OpenRouter (access 100+ models via one API) ---
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# --- DeepSeek ---
# Get key: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your_deepseek_key

# --- Mistral AI ---
# Get key: https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=your_mistral_key

# --- Perplexity AI (with web search) ---
# Get key: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-your_perplexity_key

# ===========================================================================
# 10. IMAGE / VIDEO GENERATION
# ===========================================================================

# --- FAL (image/video generation) ---
# Get key: https://fal.ai/dashboard/keys
# FAL_API_KEY=your_fal_key

# --- BFL (Black Forest Labs — FLUX image models) ---
# Get key: https://api.bfl.ml/
# BFL_API_KEY=your_bfl_key

# --- Replicate ---
# REPLICATE_API_KEY=r8_your_replicate_key

# ===========================================================================
# 11. SEARCH (web browsing for agents)
# ===========================================================================

# SearXNG (self-hosted, private search engine)
# docker run -d -p 8180:8080 searxng/searxng
# SEARXNG_URL=http://localhost:8180

# Tavily (cloud search API)
# Get key: https://tavily.com/
# TAVILY_API_KEY=tvly-your_tavily_key

# Brave Search
# Get key: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=BSAy-your_brave_key

# ===========================================================================
# 12. MCP (Model Context Protocol) SERVERS
# ===========================================================================

# MCP tool call timeout in milliseconds (default: 60 seconds)
MCP_TOOL_TIMEOUT=60000

# Klavis hosted MCP servers (optional)
# Get key: https://klavis.io
# KLAVIS_API_KEY=your_klavis_key

# ===========================================================================
# 13. EMBEDDING (for knowledge base / RAG features)
# ===========================================================================

# Default embedding + reranker config
# DEFAULT_FILES_CONFIG="embedding_model=openai/text-embedding-3-small"

# Embedding processing settings
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_CONCURRENCY=10

# ===========================================================================
# 14. SECURITY
# ===========================================================================

# SSRF protection (keep 0 for production, set 1 only for dev with local services)
SSRF_ALLOW_PRIVATE_IP_ADDRESS=0

# Content Security Policy (set to 1 to enable strict CSP headers)
# ENABLED_CSP=1

# ===========================================================================
# 15. OPTIONAL — PROVIDER TOGGLES
# ===========================================================================
# Explicitly enable/disable provider UI (1=enabled, 0=disabled)
# ENABLED_OPENAI=1
# ENABLED_OPENROUTER=1
# ENABLED_GOOGLE=1
# ENABLED_ANTHROPIC=1
# ENABLED_OLLAMA=1

# ===========================================================================
# 16. OPTIONAL — BRANDING OVERRIDE (custom logo/favicon via CDN)
# ===========================================================================
# If not set, falls back to bundled Chinna Hub assets in /public/chinna/

# BRANDING_LOGO_URL=https://cdn.yourdomain.com/chinnahub/logo.svg
# BRANDING_FAVICON_URL=https://cdn.yourdomain.com/chinnahub/favicon.png
# BRANDING_APPLE_TOUCH_ICON_URL=https://cdn.yourdomain.com/chinnahub/apple-touch-icon.png
# BRANDING_APP_ICON_192_URL=https://cdn.yourdomain.com/chinnahub/icon-192.png
# BRANDING_APP_ICON_512_URL=https://cdn.yourdomain.com/chinnahub/icon-512.png

# NEXT_PUBLIC_BRANDING_LOGO_URL=https://cdn.yourdomain.com/chinnahub/logo.svg
# NEXT_PUBLIC_BRANDING_FAVICON_URL=https://cdn.yourdomain.com/chinnahub/favicon.png

# ===========================================================================
# 17. OPTIONAL — VERCEL / NEON POSTGRES (if deploying on Vercel + Neon)
# ===========================================================================
# Vercel automatically injects these. Copy from Vercel dashboard if needed locally.
# PGHOST=your-pooler-host
# PGHOST_UNPOOLED=your-direct-host
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGDATABASE=chinnahub
# POSTGRES_URL=postgresql://user:pass@host:5432/chinnahub?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://user:pass@host-direct:5432/chinnahub?sslmode=require

# ===========================================================================
# MINIMUM WORKING CONFIG CHECKLIST
# ===========================================================================
# ✅ APP_URL
# ✅ AUTH_SECRET          (openssl rand -base64 32)
# ✅ KEY_VAULTS_SECRET    (openssl rand -base64 32)
# ✅ BETTER_AUTH_SECRET   (same or different from AUTH_SECRET)
# ✅ DATABASE_URL         (PostgreSQL)
# ✅ REDIS_URL
# ✅ S3_*                 (4 variables minimum)
# ✅ GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET  (or AUTH_DISABLE_EMAIL_PASSWORD=0)
# ✅ SMTP_*               (for email verification)
# ✅ OPENAI_API_KEY       (or any AI provider key)
# ===========================================================================
