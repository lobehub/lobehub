            },
            "size": {
              "type": "string",
              "enum": ["xs", "sm", "md", "lg", "xl", "2xl", "display"]
            },
            "tone": {
              "type": "string",
              "enum": ["default", "secondary", "tertiary", "success", "warning", "error"]
            },
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "$ref": "#/$defs/__schema39"
            },
            "weight": {
              "type": "string",
              "enum": ["regular", "medium", "semibold", "bold"]
            }
          },
          "required": ["type", "value"],
