              "$ref": "#/$defs/__schema33"
            },
            "align": {
              "type": "string",
              "enum": ["start", "center", "end", "stretch", "baseline"]
            },
            "children": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema36"
              }
            },
            "direction": {
              "type": "string",
              "enum": ["row", "column"]
            },
            "gap": {
              "$ref": "#/$defs/__schema37"
            },
            "justify": {
              "$ref": "#/$defs/__schema38"
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 48
            },
            "type": {
