  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A widget version as a draft records it: the content plus an optional change note.",
  "properties": {
    "manifest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "description": {
              "$ref": "#/$defs/__schema0"
            },
            "env": {
              "$ref": "#/$defs/__schema1"
            },
            "metric": {
              "$ref": "#/$defs/__schema8"
            },
            "network": {
              "$ref": "#/$defs/__schema10"
            },
            "params": {
              "$ref": "#/$defs/__schema13"
            },
            "schedule": {
              "$ref": "#/$defs/__schema26"
            },
            "timeoutMs": {
              "$ref": "#/$defs/__schema28"
            },
            "title": {
              "$ref": "#/$defs/__schema30"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outputType": {
      "type": "string",
      "enum": ["stat", "list", "series", "table", "data"],
      "description": "The output document type stdout must match."
    },
    "runtime": {
      "type": "string",
      "enum": ["node", "python", "bash"],
      "description": "Interpreter the sandbox runs the script with."
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144,
      "description": "Source that prints one JSON output document to stdout."
    },
    "view": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "chart": {
              "type": "string",
              "enum": ["line", "bar", "area"]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "html": {
              "type": "string",
              "minLength": 1,
              "maxLength": 204800
            },
            "layout": {
              "$ref": "#/$defs/__schema36"
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 500
            },
            "size": {
              "type": "string",
              "enum": ["sm", "md", "lg"]
            },
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "default",
                    "sky",
                    "cloudy",
                    "rain",
                    "storm",
                    "snow",
                    "night",
                    "sunset",
                    "forest",
                    "ocean",
                    "sand",
                    "rose",
                    "slate"
                  ]
                },
                {
                  "$ref": "#/$defs/__schema40"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "changeNote": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
