              "$ref": "#/$defs/__schema31"
            },
            "hideWhen": {
              "$ref": "#/$defs/__schema32"
            },
            "visible": {
              "$ref": "#/$defs/__schema33"
            },
            "color": {
              "$ref": "#/$defs/__schema39"
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "total": {
              "$ref": "#/$defs/__schema39"
            },
            "type": {
              "type": "string",
              "const": "dots"
            },
            "value": {
              "$ref": "#/$defs/__schema39"
            }
          },
          "required": ["total", "type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
