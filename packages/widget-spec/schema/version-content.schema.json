              "items": {
                "$ref": "#/$defs/__schema36"
              }
            },
            "color": {
              "$ref": "#/$defs/__schema39"
            },
            "max": {
              "$ref": "#/$defs/__schema39"
            },
            "size": {
              "type": "number",
              "minimum": 24,
              "maximum": 400
            },
            "type": {
