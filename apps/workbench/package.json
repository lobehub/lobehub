{
  "name": "@lobehub/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:report": "NODE_ENV=production vite build -c vite.config.report.mts",
    "build:rr": "react-router build -c vite.config.rr.mts",
    "deploy": "bun scripts/deploy.ts",
    "deploy:rr": "wrangler deploy --dry-run",
    "dev": "vite --port 3014",
    "dev:rr": "react-router dev -c vite.config.rr.mts",
    "preview:rr": "vite preview --config vite.config.rr.mts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@react-router/dev": "^8.5.1",
    "isbot": "^5.2.2",
    "wrangler": "^4.156.0"
  }
}
