  "full manifest": {
    "data": {
      "manifest": {
        "description": "Open issues",
        "env": [
          {
            "connector": "github",
            "inject": {
              "header": "Authorization",
              "host": "api.github.com",
              "prefix": "Bearer "
            },
            "name": "GITHUB_TOKEN",
            "required": true
          }
        ],
        "metric": {
          "key": "open_issues",
          "kind": "gauge",
          "unit": "issues",
          "valuePath": "value"
        },
        "network": {
          "allow": ["api.github.com"]
        },
        "params": [
          {
            "default": "lobehub/lobehub",
            "name": "REPO",
            "required": true,
            "type": "string"
          }
        ],
        "schedule": {
          "pattern": "*/30 * * * *",
          "timezone": "Asia/Shanghai"
        },
        "timeoutMs": 30000,
        "title": "Issues"
      },
      "outputType": "stat",
      "runtime": "python",
      "script": "console.log(JSON.stringify({ type: \"stat\", value: 1 }))",
      "view": {
        "size": "md"
      },
      "changeNote": "first cut"
    },
    "success": true
  },
