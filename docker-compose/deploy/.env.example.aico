# Aico deploy infrastructure environment
# Keep this file infra-only. Do NOT duplicate app config from ../../.env.

# Host port mappings
LOBE_PORT=3210
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
# Control plane (moz starts aico-control-plane automatically)
# AICO_CONTROL_PLANE_PORT=3020
# AICO_CONTROL_PLANE_PUBLIC_URL=http://localhost:3020
# AICO_INSECURE_AUTH_COOKIES=1
# Required strong token (moz generates if missing). `devtok` is rejected.
# AICO_CONTROL_PLANE_SERVICE_TOKEN=
# AICO_ALLOW_INSECURE_CONTROL_PLANE=1

# Database
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change-me-strong-password

# PanaChat runtime data (outside repo)
# - Postgres: Docker named volume `panachat_postgres_data` (avoids WSL2 bind→tmpfs empty DB)
# - Redis/RustFS: binds under PANACHAT_DATA_DIR/{redis,rustfs}
# - Legacy cold copy may exist at PANACHAT_DATA_DIR/postgres after migration
# Default: ~/.local/share/panachat-data (XDG — hidden, not loose in $HOME)
#
# Backups (pg_dump + rustfs): ~/.local/share/panachat-backups
#   moz -B                                 # manual
#   moz -u / moz -d                        # auto pre-deploy backup
#   ./scripts/panachat-backup.sh --install-cron   # daily 03:00
# Reset DB: moz -k && docker volume rm panachat_postgres_data && MOZ_ALLOW_EMPTY_DB=1 moz -d
PANACHAT_DATA_DIR=/home/you/.local/share/panachat-data
# PANACHAT_BACKUP_DIR=/home/you/.local/share/panachat-backups

# RustFS / object storage bootstrap
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change-me-strong-password
RUSTFS_LOBE_BUCKET=lobe

# Required by auth bootstrap / JWT signing keys used by the stack
JWKS_KEY={"keys":[{"kty":"RSA","kid":"replace-me","use":"sig","alg":"RS256","n":"replace-me","e":"AQAB","d":"replace-me","p":"replace-me","q":"replace-me","dp":"replace-me","dq":"replace-me","qi":"replace-me"}]}
