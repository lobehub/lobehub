# Chinna Hub — Production Environment
# Domain: https://app.itsmechinna.com
# Generated: 2026-05-19

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
APP_URL=https://app.itsmechinna.com

# ─────────────────────────────────────────────
# SECRETS (generate with: openssl rand -base64 32)
# ─────────────────────────────────────────────
AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
KEY_VAULTS_SECRET=REPLACE_WITH_GENERATED_SECRET

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
LOBE_DB_NAME=chinnahub
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─────────────────────────────────────────────
# S3 STORAGE (RustFS)
# ─────────────────────────────────────────────
S3_ACCESS_KEY_ID=REPLACE_WITH_STRONG_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STRONG_SECRET
S3_BUCKET=chinnahub
S3_ENDPOINT=https://app.itsmechinna.com/s3
S3_PUBLIC_DOMAIN=https://app.itsmechinna.com/s3

# ─────────────────────────────────────────────
# GOOGLE OAUTH
# https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ─────────────────────────────────────────────
# SMTP EMAIL
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_EMAIL
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
SMTP_FROM=Chinna Hub <noreply@itsmechinna.com>

# ─────────────────────────────────────────────
# AI PROVIDERS (add what you have)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_PROXY_URL=http://ollama:11434
