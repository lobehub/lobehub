# Proxy, if you need it
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890


# Other environment variables, as needed. You can refer to the environment variables configuration for the client version, making sure not to have ACCESS_CODE.
# OPENAI_API_KEY=sk-xxxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
# OPENAI_MODEL_LIST=...

# API key for /api/agent/cron/dispatch endpoint (optional in local dev)
# AGENT_CRON_DISPATCH_API_KEY=change_this_to_a_long_random_string
# AGENT_CRON_DISPATCH_MAX_JOBS_PER_TICK=100
# AGENT_CRON_DISPATCH_CONCURRENCY=5

# Optional: cron dispatcher sidecar settings (used with --profile cron)
# CRON_DISPATCH_URL=http://host.docker.internal:3010/api/agent/cron/dispatch
# CRON_DISPATCH_INTERVAL_SECONDS=60


# ===========================
# ====== Preset config ====== 
# ===========================
# if no special requirements, no need to change
LOBE_PORT=3210
RUSTFS_PORT=9000

# Postgres related, which are the necessary environment variables for DB
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change_this_password_on_production

# RUSTFS S3 configuration
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_password_on_production

# Configure the bucket information of RUSTFS
S3_ENDPOINT=http://localhost:9000
RUSTFS_LOBE_BUCKET=lobe
