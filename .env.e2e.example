BASE_URL=http://localhost:3010
HEADLESS=true
HEYANG_E2E_BROWSER_CHANNEL=msedge
HEYANG_E2E_STEP_TIMEOUT_MS=90000

# Set to 1 after the enterprise branding task lands.
HEYANG_E2E_STRICT_BRAND=0
HEYANG_E2E_BRAND_FALLBACK=LobeHub

# Real Kimi/NewAPI compatibility suite. Keep this file local and never commit secrets.
HEYANG_KIMI_BASE_URL=http://172.17.111.60:8095/innerapi/newapi/v1
HEYANG_KIMI_API_KEY=sk-your-test-key
HEYANG_KIMI_MODEL=kimi-k2.6
HEYANG_KIMI_TEMPERATURE=1

# Default keeps normal heyang:e2e cheap. Use @real-llm for the Kimi suite.
HEYANG_E2E_TAGS=@smoke and not @real-llm
