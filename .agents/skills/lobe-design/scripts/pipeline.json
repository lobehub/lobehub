          "@selfcheck",
          "node scripts/bootstrap.mjs --check && node scripts/project-scan.mjs --check"
        ]
      ],
      "note": "写文件前必须先给用户看要写入的内容；已有内容一律保留；项目层落在 .agents/ux/，不改应用代码。"
